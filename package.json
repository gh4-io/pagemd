{
  "name": "pagemd-monorepo",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "devDependencies": {
    "npm-run-all": "^4.1.5",
    "vitest": "^2.1.8"
  },
  "scripts": {
    "dev": "npm-run-all --parallel dev:*",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "cosmiconfig": "^9.0.0",
    "gray-matter": "^4.0.3",
    "js-yaml": "^4.1.1",
    "markdown-it": "^14.1.0",
    "markdown-it-attrs": "^4.3.1"
  }
}
