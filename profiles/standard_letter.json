{
  "id": "standard_letter",
  "description": "Standard US Letter layout for SOPs and documentation",

  "resources": {
    "template": "${projectRoot}/templates/standard_letter.html",
    "layout": "${projectRoot}/layouts/letter.css",
    "css": ["${projectRoot}/styles/primary.css"],
    "fonts": [],
    "assets": []
  },

  "pagedjs": {
    "mode": "browser"
  },
  "outputs": {
    "pdf": {
      "enabled": true,
      "mode": "ACTIVE_ONLY",
      "options": {}
    },
    "html": {
      "enabled": false,
      "mode": "DISABLED",
      "options": {}
    },
    "png": {
      "enabled": false,
      "mode": "DISABLED",
      "options": {}
    },
    "jpeg": {
      "enabled": false,
      "mode": "DISABLED",
      "options": {}
    }
  },
  "validation": {
    "required_fields": ["document_id", "title"]
  },
  "metadata": {
    "defaults": {
      "status": "Draft",
      "revision": 0
    }
  }
}
