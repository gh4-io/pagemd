{
  "id": "{{name}}",
  "description": "Custom PageMD profile",
  "extends": "standard_letter",

  "resources": {
    "template": null,
    "layout": null,
    "css": []
  },

  "layout": {
    "pageSize": "Letter",
    "orientation": "portrait"
  },

  "outputs": {
    "pdf": {
      "enabled": true,
      "mode": "ACTIVE_ONLY"
    },
    "html": {
      "enabled": false
    },
    "png": {
      "enabled": false
    },
    "jpeg": {
      "enabled": false
    }
  },

  "validation": {
    "required_fields": ["document_id", "title"]
  }
}
