{
  "id": "handbook",
  "description": "Full handbook setup with academic styling for manuals and guides",

  "resources": {
    "template": "../templates/handbook.html",
    "layout": "../layouts/handbook.css",
    "css": ["../styles/06-academic.css"],
    "fonts": [],
    "assets": []
  },

  "pagedjs": {
    "mode": "browser"
  },
  "outputs": {
    "pdf": {
      "enabled": true,
      "mode": "ACTIVE_ONLY",
      "options": {}
    },
    "html": {
      "enabled": false,
      "mode": "DISABLED",
      "options": {}
    },
    "png": {
      "enabled": false,
      "mode": "DISABLED",
      "options": {}
    },
    "jpeg": {
      "enabled": false,
      "mode": "DISABLED",
      "options": {}
    }
  },
  "validation": {
    "required_fields": ["title"]
  },
  "metadata": {
    "defaults": {
      "status": "Draft",
      "revision": 0,
      "page_numbers": true,
      "running_header": true,
      "running_footer": true
    }
  }
}
