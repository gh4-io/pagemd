{
  "id": "color-scheme",
  "description": "Profile for testing light/dark color scheme themes",
  "extends": "standard_letter",

  "resources": {
    "css": ["${projectRoot}/styles/primary.css", "../styles/02-color-scheme.css"]
  },

  "pagedjs": {
    "mode": "browser"
  },
  "outputs": {
    "pdf": {
      "enabled": true,
      "mode": "ACTIVE_ONLY",
      "options": {}
    },
    "html": {
      "enabled": false,
      "mode": "DISABLED",
      "options": {}
    },
    "png": {
      "enabled": false,
      "mode": "DISABLED",
      "options": {}
    },
    "jpeg": {
      "enabled": false,
      "mode": "DISABLED",
      "options": {}
    }
  },
  "validation": {
    "required_fields": ["title"]
  },
  "metadata": {
    "defaults": {
      "status": "Draft",
      "revision": 0,
      "page_numbers": false,
      "running_header": false,
      "running_footer": false
    }
  }
}
