{
  "id": "legal",
  "description": "Legal profile for formal and legal documents with traditional formatting",

  "resources": {
    "template": "standard_letter",
    "css": ["../styles/04-legal.css"]
  },


  "pagedjs": {
    "mode": "browser"
  },
  "outputs": {
    "pdf": {
      "enabled": true,
      "mode": "ACTIVE_ONLY",
      "options": {}
    },
    "html": {
      "enabled": false,
      "mode": "DISABLED",
      "options": {}
    },
    "png": {
      "enabled": false,
      "mode": "DISABLED",
      "options": {}
    },
    "jpeg": {
      "enabled": false,
      "mode": "DISABLED",
      "options": {}
    }
  },
  "validation": {
    "required_fields": ["title"]
  },
  "metadata": {
    "defaults": {
      "status": "Draft",
      "revision": 0,
      "page_numbers": true,
      "running_header": false,
      "running_footer": true
    }
  }
}
