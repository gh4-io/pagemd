{
  "id": "corporate",
  "description": "Corporate profile for business documents with professional styling",

  "resources": {
    "template": null,
    "layout": null,
    "css": ["../styles/03-corporate.css"],
    "fonts": [],
    "assets": []
  },

  "pagedjs": {
    "mode": "browser"
  },
  "outputs": {
    "pdf": {
      "enabled": true,
      "mode": "ACTIVE_ONLY",
      "options": {}
    },
    "html": {
      "enabled": false,
      "mode": "DISABLED",
      "options": {}
    },
    "png": {
      "enabled": false,
      "mode": "DISABLED",
      "options": {}
    },
    "jpeg": {
      "enabled": false,
      "mode": "DISABLED",
      "options": {}
    }
  },
  "validation": {
    "required_fields": ["title"]
  },
  "metadata": {
    "defaults": {
      "status": "Draft",
      "revision": 0,
      "page_numbers": true,
      "running_header": true,
      "running_footer": true
    }
  }
}
