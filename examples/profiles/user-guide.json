{
  "id": "user-guide",
  "description": "Software manual and user guide layout with technical styling",

  "resources": {
    "template": "../templates/user-guide.html",
    "layout": "../layouts/user-guide.css",
    "css": ["../styles/05-technical.css"],
    "fonts": [],
    "assets": []
  },

  "pagedjs": {
    "mode": "browser"
  },
  "outputs": {
    "pdf": {
      "enabled": true,
      "mode": "ACTIVE_ONLY",
      "options": {}
    },
    "html": {
      "enabled": false,
      "mode": "DISABLED",
      "options": {}
    },
    "png": {
      "enabled": false,
      "mode": "DISABLED",
      "options": {}
    },
    "jpeg": {
      "enabled": false,
      "mode": "DISABLED",
      "options": {}
    }
  },
  "validation": {
    "required_fields": ["title"]
  },
  "metadata": {
    "defaults": {
      "status": "Draft",
      "revision": 0,
      "page_numbers": true,
      "running_header": true,
      "running_footer": true
    }
  }
}
